# Copy to .env and fill in your values: cp .env.example .env
# Empty values fall back to the default shown in each comment.

# --- LLM provider ---
# Provider to use: anthropic | openai (default: anthropic)
LLM_PROVIDER=
# Model to use (default: claude-haiku-4-5 for anthropic, gpt-4o-mini for openai)
LLM_MODEL=

# --- API keys (only the selected provider's key is required) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Application ---
# Runtime environment (default: development)
APP_ENV=
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: DEBUG)
LOG_LEVEL=
